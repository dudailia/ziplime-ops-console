{
  "name": "ops-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-css.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:full": "STORE_DIFF_SEEDS=200 FUZZ_RANDOM=1 vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "PYTHONDONTWRITEBYTECODE=1 ../ziplime/.venv/bin/python scripts/generate_seed.py",
    "typecheck": "next typegen && tsc --noEmit",
    "test:forwarder": "PYTHONDONTWRITEBYTECODE=1 python3 -m pytest forwarder -q -p no:cacheprovider",
    "test:ingest": "playwright test -c playwright.ingest.config.ts",
    "db:migrate": "DB_TASK=migrate vitest run --config vitest.scripts.config.ts",
    "db:seed": "DB_TASK=seed vitest run --config vitest.scripts.config.ts",
    "bench:ingest": "BENCH=ingest vitest run --config vitest.scripts.config.ts scripts/bench-ingest.run.ts",
    "test:link-check": "node --test tools/link-check/*.test.mjs",
    "link-check": "node tools/link-check/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "0.5.8",
    "next": "16.4.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-check": "4.10.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
